# ==============================================================================
# NEXORA Git Ignore Rules
# Protect sensitive credentials, environment files, and local build artifacts
# ==============================================================================

# Environment variables & API keys (CRITICAL - Never commit secrets!)
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# Vercel CLI local configuration and build output
.vercel

# Node.js dependencies & logs (if package manager is used)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Operating System temporary files
.DS_Store
Thumbs.db

# Code editor configurations
.idea/
.vscode/
*.swp
*.swo
